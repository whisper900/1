# Copy this file to .env and fill in the values from https://my.telegram.org
# (log in -> "API development tools" -> create an application).
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Optional: skip the phone prompt on first login.
# TG_PHONE=+<country code><number>

# Optional: name of the session file (default: tgdl -> tgdl.session).
# TG_SESSION=tgdl
